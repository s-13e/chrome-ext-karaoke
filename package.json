  "scripts": {
    "build": "webpack --config webpack/webpack.prod.js",
    "dev": "webpack --config webpack/webpack.dev.js --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "test": "jest --coverage",
    "prepare": "husky",
    "clean": "rimraf dist",
